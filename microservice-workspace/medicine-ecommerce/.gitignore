cat > .gitignore << 'EOF'
# Environment files - NEVER commit these
.env
.env.local
.env.development
.env.production
.env.*.local
*.env

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
out/
target/
*.class
*.jar

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/
*.lcov

# Docker volumes (if any get created locally)
volumes/
data/

# OS files
.DS_Store
Thumbs.db

# Secrets and keys
*.pem
*.key
*.crt
secrets/
EOF
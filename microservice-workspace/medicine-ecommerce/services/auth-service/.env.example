NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
SERVICE_NAME=auth-service

DATABASE_HOST=postgres-auth
DATABASE_PORT=5432
DATABASE_USER=auth_user
DATABASE_PASSWORD=auth_pass
DATABASE_NAME=auth_db
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
RABBITMQ_EXCHANGE=user.events

JWT_ISSUER=medicine-ecommerce-auth
JWT_AUDIENCE=medicine-ecommerce
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_KEY_ID=auth-key-1

BCRYPT_ROUNDS=12

ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1

TWO_FACTOR_APP_NAME=MedicineEcommerce
TWO_FACTOR_WINDOW=1

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Medicine Store
SMTP_FROM_EMAIL=noreply@medicine-store.com
APP_URL=http://localhost:3000

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

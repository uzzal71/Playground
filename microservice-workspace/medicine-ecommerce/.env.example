cat > .env.example << 'EOF'
# =============================================================================
# Root .env.example - copy to .env for local development
# Each service has its own .env.example too — see services/<name>/.env.example
# =============================================================================

# Compose project name
COMPOSE_PROJECT_NAME=medicine-ecommerce

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Default ports (change if any conflict on your machine)
GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
RABBITMQ_UI_PORT=15672
JAEGER_UI_PORT=16686
EOF
{
    "openapi": "3.0.0",
    "info": {
        "title": "Microfinance Loan Management API",
        "description": "REST API for borrower registration, authentication (JWT), loan application, and repayment schedule management. Uses dual-database architecture: PostgreSQL for auth, MySQL for loan data.",
        "contact": {
            "email": "admin@microfinance.test"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Local API Server"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new borrower",
                "description": "Creates a new user in PostgreSQL and returns JWT access + refresh tokens.",
                "operationId": "registerBorrower",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Registration successful"
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "$ref": "#/components/schemas/User"
                                                },
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "refresh_token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login a borrower",
                "description": "Authenticates against PostgreSQL and returns JWT access + refresh tokens.",
                "operationId": "loginBorrower",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "$ref": "#/components/schemas/User"
                                                },
                                                "access_token": {
                                                    "type": "string"
                                                },
                                                "refresh_token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer",
                                                    "example": 3600
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/refresh": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh JWT access token",
                "description": "Returns a new access token and refresh token.",
                "operationId": "refreshToken",
                "responses": {
                    "200": {
                        "description": "Token refreshed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Token refreshed"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/TokenResponse"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout (invalidate token)",
                "operationId": "logoutBorrower",
                "responses": {
                    "200": {
                        "description": "Logged out",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Successfully logged out"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/me": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get authenticated user profile",
                "operationId": "currentUser",
                "responses": {
                    "200": {
                        "description": "User profile",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/loans/apply": {
            "post": {
                "tags": [
                    "Loans"
                ],
                "summary": "Apply for a new microfinance loan",
                "description": "Creates a loan (auto-APPROVED) in MySQL and generates a monthly repayment schedule with 10% interest.",
                "operationId": "applyForLoan",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoanApplyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Loan approved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Loan application approved"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Loan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/loans": {
            "get": {
                "tags": [
                    "Loans"
                ],
                "summary": "List all loans for the authenticated user",
                "operationId": "getUserLoans",
                "responses": {
                    "200": {
                        "description": "Loans retrieved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Loan"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/loans/{id}/repayments": {
            "get": {
                "tags": [
                    "Loans"
                ],
                "summary": "Get repayment schedule for a specific loan",
                "operationId": "getLoanRepayments",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Loan ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Repayment schedule retrieved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/RepaymentSchedule"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Loan not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "SuccessResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Operation successful"
                    },
                    "data": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Something went wrong"
                    },
                    "errors": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "TokenResponse": {
                "properties": {
                    "access_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUz..."
                    },
                    "refresh_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUz..."
                    },
                    "token_type": {
                        "type": "string",
                        "example": "bearer"
                    },
                    "expires_in": {
                        "type": "integer",
                        "example": 3600
                    }
                },
                "type": "object"
            },
            "LoanApplyRequest": {
                "required": [
                    "loan_amount",
                    "loan_term_months",
                    "purpose",
                    "monthly_income",
                    "requested_date"
                ],
                "properties": {
                    "loan_amount": {
                        "type": "number",
                        "format": "double",
                        "example": 50000
                    },
                    "loan_term_months": {
                        "type": "integer",
                        "example": 12
                    },
                    "purpose": {
                        "type": "string",
                        "example": "Business Expansion"
                    },
                    "monthly_income": {
                        "type": "number",
                        "format": "double",
                        "example": 25000
                    },
                    "requested_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-06-01"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "SecurePass123!"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "full_name",
                    "email",
                    "mobile",
                    "address",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "full_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "mobile": {
                        "type": "string",
                        "example": "+8801712345678"
                    },
                    "address": {
                        "type": "string",
                        "example": "123 Main St, Dhaka"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "SecurePass123!"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "SecurePass123!"
                    }
                },
                "type": "object"
            },
            "Loan": {
                "required": [
                    "id",
                    "user_id",
                    "loan_amount",
                    "loan_term_months",
                    "purpose",
                    "monthly_income",
                    "requested_date",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "loan_amount": {
                        "type": "number",
                        "format": "double",
                        "example": 50000
                    },
                    "loan_term_months": {
                        "type": "integer",
                        "example": 12
                    },
                    "purpose": {
                        "type": "string",
                        "example": "Business Expansion"
                    },
                    "monthly_income": {
                        "type": "number",
                        "format": "double",
                        "example": 25000
                    },
                    "requested_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-06-01"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "APPROVED",
                            "REJECTED",
                            "PENDING"
                        ],
                        "example": "APPROVED"
                    },
                    "total_interest": {
                        "type": "number",
                        "format": "double",
                        "example": 5000
                    },
                    "total_payable": {
                        "type": "number",
                        "format": "double",
                        "example": 55000
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "RepaymentSchedule": {
                "required": [
                    "id",
                    "loan_id",
                    "installment_number",
                    "due_date",
                    "principal_amount",
                    "interest_amount",
                    "installment_amount",
                    "remaining_balance"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "loan_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "installment_number": {
                        "type": "integer",
                        "example": 1
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-07-01"
                    },
                    "principal_amount": {
                        "type": "number",
                        "format": "double",
                        "example": 4166.67
                    },
                    "interest_amount": {
                        "type": "number",
                        "format": "double",
                        "example": 416.67
                    },
                    "installment_amount": {
                        "type": "number",
                        "format": "double",
                        "example": 4583.33
                    },
                    "remaining_balance": {
                        "type": "number",
                        "format": "double",
                        "example": 45833.33
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PENDING",
                            "PAID"
                        ],
                        "example": "PENDING"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "User": {
                "required": [
                    "id",
                    "full_name",
                    "email",
                    "mobile",
                    "address"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "full_name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "mobile": {
                        "type": "string",
                        "example": "+8801712345678"
                    },
                    "address": {
                        "type": "string",
                        "example": "123 Main St, Dhaka"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Enter JWT access token"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Loans",
            "description": "Loans"
        }
    ]
}